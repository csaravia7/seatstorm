TAG=dev
# Docker Hub (personal account): images are docker.io/$DOCKER_ID/<service>:$TAG
DOCKER_ID=
# Personal access token (read-only is enough for clusters; read/write only to push). NEVER commit it.
DOCKER_PAT=
DB_PASSWORD=seatstorm
ADMIN_TOKEN=change-me-admin
SESSION_SECRET=change-me-32-bytes-minimum-secret
CONSOLE_PIN=4321
TICKET_SECRET=change-me-ticket-secret
# Agent LLM: anthropic | nvidia
LLM_PROVIDER=anthropic
LLM_FALLBACK_PROVIDER=
LLM_MAX_RPM=30
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_TEMPERATURE=1
NVIDIA_TOP_P=1
NVIDIA_MAX_TOKENS=4096
# Optional links shown in the console
KAFKA_UI_URL=http://localhost:8085
DYNATRACE_URL=
