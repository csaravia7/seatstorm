{
  "name": "seatstorm",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installMaven": "false"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  "forwardPorts": [
    8080,
    8085
  ],
  "portsAttributes": {
    "8080": {
      "label": "SeatStorm",
      "onAutoForward": "openBrowser"
    },
    "8085": {
      "label": "Kafka UI"
    }
  },
  "secrets": {
    "DOCKER_ID": {
      "description": "Your Docker Hub username (images are docker.io/<DOCKER_ID>/<service>)"
    },
    "DOCKER_PAT": {
      "description": "Docker Hub personal access token (read-only to pull; read/write to push images)"
    },
    "ANTHROPIC_API_KEY": {
      "description": "Anthropic API key (assistant-agent)"
    },
    "NVIDIA_API_KEY": {
      "description": "NVIDIA NIM API key, free tier (assistant-agent)"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "java.import.maven.enabled": false,
        "java.autobuild.enabled": false,
        "java.configuration.updateBuildConfiguration": "disabled",
        "maven.terminal.useJavaHome": true
      }
    }
  },
  "postStartCommand": "nohup bash scripts/codespaces-public-port.sh 8080 900 > /tmp/public-port.log 2>&1 &"
}
