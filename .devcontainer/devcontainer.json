{
  "name": "seatstorm",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installMaven": "false"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  "forwardPorts": [
    8080,
    8085
  ],
  "portsAttributes": {
    "8080": {
      "label": "SeatStorm",
      "onAutoForward": "openBrowser"
    },
    "8085": {
      "label": "Kafka UI"
    }
  },
  "secrets": {
    "DOCKERHUB_USER": {
      "description": "Docker Hub user (avoids the anonymous pull limit)"
    },
    "DOCKERHUB_TOKEN": {
      "description": "Docker Hub access token (read)"
    },
    "ANTHROPIC_API_KEY": {
      "description": "Anthropic API key (assistant-agent)"
    },
    "NVIDIA_API_KEY": {
      "description": "NVIDIA NIM API key, free tier (assistant-agent)"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-quarkus",
        "vscjava.vscode-java-pack",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "postStartCommand": "nohup bash scripts/codespaces-public-port.sh 8080 900 > /tmp/public-port.log 2>&1 &"
}
