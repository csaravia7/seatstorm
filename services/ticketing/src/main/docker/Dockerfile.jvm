# Build context = repository root:  docker build -f services/ticketing/src/main/docker/Dockerfile.jvm .
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY . .
RUN mvn -B -DskipTests package -pl services/ticketing -am

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /build/services/ticketing/target/quarkus-app/lib/ ./lib/
COPY --from=build /build/services/ticketing/target/quarkus-app/*.jar ./
COPY --from=build /build/services/ticketing/target/quarkus-app/app/ ./app/
COPY --from=build /build/services/ticketing/target/quarkus-app/quarkus/ ./quarkus/
EXPOSE 8080
USER 1001
ENTRYPOINT ["java", "-jar", "quarkus-run.jar"]
